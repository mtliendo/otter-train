# Lakebase Postgres (Neon). App traffic can use the pooled URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Direct (non-pooled) URL for Drizzle migrations. Falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Auth fallback. Omit to auto-stub when AUTH0_CLIENT_SECRET is missing.
# Set to false once the otter-train client secret is present.
AUTH_STUB=true

# --- Auth0 (@auth0/nextjs-auth0 v4) ---
# Tenant: demo-showcase
# App: otter-train
# Domain confirmed via OIDC: demo-showcase.us.auth0.com
AUTH0_DOMAIN=demo-showcase.us.auth0.com
AUTH0_CLIENT_ID=CBR8NFocoUkfCCtEPVC9oEciT4s8Ez7E
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
# Local only. On Vercel Preview, omit so the SDK uses https://$VERCEL_URL.
APP_BASE_URL=http://localhost:3000
