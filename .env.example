# Lakebase Postgres (Neon). App traffic can use the pooled URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Direct (non-pooled) URL for Drizzle migrations. Falls back to DATABASE_URL if unset.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Dev stub user (Focus). Leave true until Auth0 is wired.
AUTH_STUB=true

# --- Auth0 (@auth0/nextjs-auth0) ---
# Tenant: demo-showcase
# App: otter-train
# Confirm the region suffix if login fails (demo-showcase.auth0.com vs demo-showcase.us.auth0.com).
AUTH0_DOMAIN=demo-showcase.us.auth0.com
AUTH0_CLIENT_ID=CBR8NFocoUkfCCtEPVC9oEciT4s8Ez7E
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
